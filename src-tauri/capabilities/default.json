{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default-capabilities",
  "description": "Default capabilities for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "shell:default",
    "updater:default",
    "process:default",
    "server-org:allow-add-server-to-folder",
    "server-org:allow-archive-server",
    "server-org:allow-assign-server-priority",
    "server-org:allow-auto-archive-inactive-servers",
    "server-org:allow-bulk-archive-servers",
    "server-org:allow-bulk-color-servers",
    "server-org:allow-bulk-move-servers",
    "server-org:allow-bulk-tag-servers",
    "server-org:allow-create-dashboard-layout",
    "server-org:allow-create-folder",
    "server-org:allow-create-server-group",
    "server-org:allow-delete-folder",
    "server-org:allow-delete-layout",
    "server-org:allow-export-server-organization",
    "server-org:allow-get-active-servers",
    "server-org:allow-get-all-folders",
    "server-org:allow-get-all-server-groups",
    "server-org:allow-get-archived-servers",
    "server-org:allow-get-dashboard-statistics",
    "server-org:allow-get-folder-hierarchy",
    "server-org:allow-get-inactive-servers",
    "server-org:allow-get-organization-snapshot",
    "server-org:allow-get-server-activity-stats",
    "server-org:allow-get-server-comparison-stats",
    "server-org:allow-get-server-customization",
    "server-org:allow-get-server-folders",
    "server-org:allow-get-servers-by-group",
    "server-org:allow-get-servers-by-map",
    "server-org:allow-get-servers-by-status",
    "server-org:allow-get-servers-by-tag",
    "server-org:allow-get-user-layouts",
    "server-org:allow-import-server-organization",
    "server-org:allow-is-server-archived",
    "server-org:allow-log-server-activity",
    "server-org:allow-remove-server-from-folder",
    "server-org:allow-reorder-servers",
    "server-org:allow-restore-server",
    "server-org:allow-search-servers",
    "server-org:allow-update-folder",
    "server-org:allow-update-server-customization"
  ]
