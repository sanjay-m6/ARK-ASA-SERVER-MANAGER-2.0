{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ARK Server Manager",
  "version": "4.6.14",
  "identifier": "com.ark.asaservermanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ASA Server Manager 2.0",
        "width": 1400,
        "height": 900,
        "minWidth": 1200,
        "minHeight": 700,
        "center": true,
        "decorations": false,
        "additionalBrowserArgs": "--disable-features=AudioServiceOutOfProcess,HardwareMediaKeyHandling,MediaSessionService --disable-speech-api --renderer-process-limit=1"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$APPDATA/**/*"
          ]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      },
      "wix": {
        "language": "en-US"
      }
    },
    "linux": {
      "deb": {
        "files": {}
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/sanjay-m6/ARK-ASA-SERVER-MANAGER-2.0/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQyQ0E1OEJCMTY1RjJGQjkKUldTNUwxOFd1MWpLMGhQeW45NGhIRVBXZlZPWWtLdGZQVmRDRk1aWWhsc3NRZWg4ZUxzWDhCTzUK"
    }
  }
}
