{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ASA Server Manager",
  "version": "4.4.5",
  "identifier": "com.ark.asaservermanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ASA Server Manager 2.0",
        "width": 1400,
        "height": 900,
        "minWidth": 1200,
        "minHeight": 700,
        "center": true,
        "additionalBrowserArgs": "--disable-features=AudioServiceOutOfProcess,HardwareMediaKeyHandling,MediaSessionService --disable-speech-api --renderer-process-limit=1"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      },
      "wix": {
        "language": "en-US"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://raw.githubusercontent.com/sanjay-m6/ASA-SERVER-MANAGER-2.0/main/updates/{{target}}.json",
        "https://raw.githubusercontent.com/sanjay-m6/ASA-SERVER-MANAGER-2.0/main/updates/release.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI4NDkxNkIzQjYxQTU0NzEKUldSeFZCcTJzeFpKS05yVU9TcXJIWHI2RTRFaWdBRTBLQ3E1SG11Z3FzSnpsV2grMWpBNkxDUjAK"
    }
  }
}